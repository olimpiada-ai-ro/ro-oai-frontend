    "license": "UNLICENSED",
    "browserslist": [
        "chrome >= 111",
        "edge >= 111",
        "firefox >= 111",
        "safari >= 15.4",
        "ios_saf >= 15.4"
    ],
    "scripts": {
        "build": "prettier . --check --ignore-path .prettierignore && next build && node scripts/verify-browser-compatibility.mjs",
        "dev": "next dev",
        "lint": "eslint . --ext .js,.jsx,.ts,.tsx --report-unused-disable-directives --max-warnings=0",
        "lint:fix": "eslint . --ext .js,.jsx,.ts,.tsx --fix",
        "format": "prettier . --write --ignore-path .prettierignore",
        "format:check": "prettier . --check --ignore-path .prettierignore",
        "start": "next start",
        "test": "vitest run",
        "test:watch": "vitest",
        "verify:env": "npx tsx scripts/verify-environment-config.ts",
        "verify:browser-compat": "node scripts/verify-browser-compatibility.mjs"
    },
